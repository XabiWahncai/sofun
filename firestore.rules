rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Scripts (game catalog) — public read, admin write
    match /scripts/{id} {
      allow read: if true;
      allow write: if request.auth != null;

      // Reviews — public read, any LINE member can write their own review
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Parties — public read, any write (LINE users, no Firebase Auth)
    match /parties/{partyId} {
      allow read: if true;
      allow write: if true;

      match /messages/{msgId} {
        allow read, write: if true;
      }
    }

    // Members — public read (profile lookups), any user can create own doc, hardened update against privilege escalation
    match /members/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null || (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || (resource.data.role == null && request.resource.data.role != 'admin'));
      allow delete: if request.auth != null;
    }

    // Orders — admin creates, LINE users can read and update their own order
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Menu items — public read, admin write
    match /menuItems/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payments — any can create (member submits slip), admin reads/updates
    match /payments/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Evaluations — public read and create (LINE members after payment), admin update/delete
    match /evaluations/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Play history — public read, admin write, retroactive records creatable and deletable by players
    match /playHistory/{id} {
      allow read: if true;
      allow create: if request.auth != null || (
        request.resource.data.isRetroactive == true ||
        request.resource.data.source == 'rehistory' ||
        request.resource.data.recordedBy == 'rehistory'
      );
      allow update: if request.auth != null || (
        resource.data.isRetroactive == true && request.resource.data.isRetroactive == true
      );
      allow delete: if request.auth != null || (
        resource.data.isRetroactive == true ||
        resource.data.source == 'rehistory' ||
        resource.data.recordedBy == 'rehistory'
      );
    }

    // Security logs — public create for audit trail/threat detection, admin read/update/delete
    match /security_logs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Settings — promotion: public read; payment: admin only
    match /settings/promotion {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/payment {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/receipt {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/counter {
      allow read, write: if true;
    }
    match /settings/booking {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/security {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/dm_recommendations {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Bookings — any LINE user can read/create/update (join, pay deposit); admin deletes
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Wheel state & history — public read for live display screen, allow write
    match /wheelSettings/{docId} {
      allow read, write: if true;
    }
    match /wheelHistory/{docId} {
      allow read, write: if true;
    }

    // POS live — shared session state across admins
    match /pos_live/{docId} {
      allow read, write: if true;
    }

    // Print jobs — queue for primary printer device to consume & print
    match /print_jobs/{docId} {
      allow read, write: if true;
    }

    // All Of Us Will Die - Among Us in real life mobile game
    match /all_of_us_games/{docId} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
