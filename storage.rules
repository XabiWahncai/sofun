rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Slip uploads: any signed-in user (including anonymous) can write,
    // only authenticated users can read (admins open the URL directly)
    match /slips/{orderId}/{filename} {
      allow write: if request.resource.size < 10 * 1024 * 1024  // 10 MB
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Game images and other assets uploaded by admin
    match /games/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
