rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Slip uploads: any user can write (LINE-authed, no Firebase Auth),
    // public read so admins can open the URL directly.
    // Matches both slips/{orderId}/{filename} and slips/deposits/{bookingId}/{filename}
    match /slips/{path=**} {
      allow write: if request.resource.size < 10 * 1024 * 1024  // 10 MB
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Game images and other assets uploaded by admin
    match /games/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
